{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://asnthxshdxymcpuoreiy.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "pink-wheels",
      "version": "0.1.0",
      "title": "Pink Wheels"
    },
    "tools": [
      {
        "name": "list_my_rides",
        "title": "List my rides",
        "description": "List the signed-in rider's recent Pink Wheel ride bookings with status and fare.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rides to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_pool_routes",
        "title": "List Pink Pool routes",
        "description": "List upcoming open Pink Pool shared routes with seats and price per seat, optionally filtered by place text.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "search": {
              "description": "Text to match in start or destination, e.g. 'DHA'.",
              "type": "string",
              "maxLength": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_fares",
        "title": "Get ride fares",
        "description": "Get the current Pink Wheel fare rates in PKR for each vehicle type (car, scooty, bike).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
